# PriceLabs API Configuration
# Copy this file to .env and fill in your actual API key
# 
# DO NOT commit .env to version control!

PRICELABS_API_KEY=your_api_key_here

# Optional: API Base URL (defaults to https://api.pricelabs.co/v1 if not set)
# API_BASE_URL=https://api.pricelabs.co/v1

# Optional: Logging Level (defaults to INFO if not set)
# LOG_LEVEL=INFO
